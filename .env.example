# ---- Server ----
HOST=127.0.0.1
PORT=8973
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Database ----
# postgres://user:pass@host:5432/db  (production / docker compose)
# pglite://./.data/pg                 (dev: Postgres nhúng, lưu vào thư mục)
# để trống                            (dev/test: Postgres nhúng trong bộ nhớ, mất khi tắt)
DATABASE_URL=

# ---- Đăng nhập ----
# Bắt buộc khi NODE_ENV=production. Sinh bằng: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Tạo/cập nhật tài khoản admin khi khởi động (mật khẩu được đặt lại theo giá trị này mỗi lần chạy)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- LLM (tuỳ chọn) — không có key thì luận giải chạy offline ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Bảo vệ luận giải LLM: cần header X-API-Key ...
API_KEY=
# ... hoặc cho phép người dùng đã đăng nhập dùng LLM mà không cần X-API-Key (1 = bật)
LLM_ALLOW_USERS=0
