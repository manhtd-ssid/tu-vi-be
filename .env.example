# ---- Server ----
HOST=127.0.0.1
PORT=8973
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Database ----
# postgres://user:pass@host:5432/db  (production / docker compose)
# pglite://./.data/pg                 (dev: Postgres nhúng, lưu vào thư mục)
# để trống                            (dev/test: Postgres nhúng trong bộ nhớ, mất khi tắt)
DATABASE_URL=

# ---- Đăng nhập ----
# Bắt buộc khi NODE_ENV=production. Sinh bằng: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Phiên đăng nhập trên trình duyệt nằm trong cookie httpOnly "tuvi_session".
# API và trang web phải cùng "site" (vd. tuvi.vn + api.tuvi.vn) để cookie SameSite=Lax hoạt động;
# khác site thì đặt COOKIE_SAMESITE=none (bắt buộc HTTPS). COOKIE_SECURE mặc định bật khi NODE_ENV=production.
COOKIE_SAMESITE=lax
COOKIE_SECURE=
COOKIE_DOMAIN=
# Chạy sau load balancer / reverse proxy: bật để giới hạn request theo đúng IP người dùng
TRUST_PROXY=0
# 0 = tắt giới hạn request (chỉ dùng khi dev)
RATE_LIMIT=1
# Tạo/cập nhật tài khoản admin khi khởi động (mật khẩu được đặt lại theo giá trị này mỗi lần chạy)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- LLM (tuỳ chọn) — không có key thì luận giải chạy offline ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Luận giải AI cho người dùng cần đăng nhập + còn lượt (mua gói). X-API-Key = API_KEY dùng nội bộ, không tính lượt.
API_KEY=
# Số cung tối thiểu AI viết được (qua Guardrail) thì mới trừ lượt
MIN_CUNG_AI=7

# ---- Email (SMTP: Resend, Amazon SES, Brevo, Gmail...) ----
# Để trống: không gửi email thật, nội dung được in ra log (dev)
SMTP_URL=
MAIL_FROM=Tử Vi Vi Tinh <no-reply@example.com>
# Địa chỉ trang web (tu-vi-fe) dùng trong link email xác nhận / đặt lại mật khẩu
APP_URL=http://localhost:3000
# Địa chỉ công khai của backend (dùng làm redirect URI của Google). Trống = lấy từ request.
PUBLIC_API_URL=

# Hỏi đáp AI: số câu đổi được từ 1 lượt, số câu tối đa mỗi người mỗi 24 giờ
HOI_DAP_CAU_MOI_LUOT=5
HOI_DAP_MAX_NGAY=30

# ---- Đăng nhập Google (Google Cloud Console → Credentials → OAuth client ID, loại Web) ----
# Redirect URI: <PUBLIC_API_URL>/v1/auth/google/callback. Trống = ẩn nút Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Bắt buộc xác thực email trước khi mua gói (0 = không bắt buộc)
REQUIRE_EMAIL_VERIFIED=1

# Chỉ cho test end-to-end: LLM_PROVIDER=fake dùng LLM giả (không gọi mạng). Bị cấm khi NODE_ENV=production.
LLM_PROVIDER=

# Phễu chuyển đổi (bảng events, cookie ẩn danh tuvi_vid). 0 = tắt
ANALYTICS=1

# ---- Chi phí LLM ----
# Dừng luận giải AI khi chi phí trong ngày (giờ VN) chạm ngưỡng này (USD). Để trống = không giới hạn.
LLM_DAILY_BUDGET_USD=
# Giá USD / 1 triệu token, ghi đè bảng giá có sẵn (claude-sonnet-5-5: 2 / 10)
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=

# ---- Thanh toán SePay (chuyển khoản VietQR) ----
# Tài khoản nhận tiền đã liên kết với SePay. SEPAY_BANK là tên ngân hàng dạng SePay dùng trong QR (vd. MBBank, Vietcombank, ACB)
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# my.sepay.vn → Webhooks → Thêm webhook: URL https://<api>/v1/payments/sepay/webhook,
# kiểu chứng thực "API Key", điền cùng khoá bí mật này
SEPAY_WEBHOOK_KEY=
# Tiền tố mã đơn trong nội dung chuyển khoản (mã đơn = tiền tố + 8 ký tự A-Z/2-9) và thời gian giữ đơn
ORDER_PREFIX=TUVI
ORDER_EXPIRES_MIN=30
