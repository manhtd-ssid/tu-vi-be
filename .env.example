# ---- Server ----
HOST=127.0.0.1
PORT=8973
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Database ----
# postgres://user:pass@host:5432/db  (production / docker compose)
# pglite://./.data/pg                 (dev: Postgres nhúng, lưu vào thư mục)
# để trống                            (dev/test: Postgres nhúng trong bộ nhớ, mất khi tắt)
DATABASE_URL=

# ---- Đăng nhập ----
# Bắt buộc khi NODE_ENV=production. Sinh bằng: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Tạo/cập nhật tài khoản admin khi khởi động (mật khẩu được đặt lại theo giá trị này mỗi lần chạy)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- LLM (tuỳ chọn) — không có key thì luận giải chạy offline ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Luận giải AI cho người dùng cần đăng nhập + còn lượt (mua gói). X-API-Key = API_KEY dùng nội bộ, không tính lượt.
API_KEY=
# Số cung tối thiểu AI viết được (qua Guardrail) thì mới trừ lượt
MIN_CUNG_AI=7

# ---- Thanh toán SePay (chuyển khoản VietQR) ----
# Tài khoản nhận tiền đã liên kết với SePay. SEPAY_BANK là tên ngân hàng dạng SePay dùng trong QR (vd. MBBank, Vietcombank, ACB)
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# my.sepay.vn → Webhooks → Thêm webhook: URL https://<api>/v1/payments/sepay/webhook,
# kiểu chứng thực "API Key", điền cùng khoá bí mật này
SEPAY_WEBHOOK_KEY=
# Tiền tố mã đơn trong nội dung chuyển khoản (mã đơn = tiền tố + 8 ký tự A-Z/2-9) và thời gian giữ đơn
ORDER_PREFIX=TUVI
ORDER_EXPIRES_MIN=30
